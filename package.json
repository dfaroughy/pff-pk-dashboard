{
  "name": "pff-pk-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:empirical": "npm --prefix apps/empirical run dev:portable:full",
    "dev:synthetic": "npm run dev:empirical",
    "build": "npm run build:empirical",
    "build:empirical": "npm --prefix apps/empirical run build:portable",
    "build:pages": "npm run build && node scripts/assemble-pages.mjs",
    "test:pages": "node --test tests/pages-bundle.test.mjs",
    "check": "npm --prefix apps/empirical run typecheck && npm --prefix apps/empirical run lint && npm --prefix apps/empirical run test:unit && npm run build:pages && npm --prefix apps/empirical run test:built && npm run test:pages",
    "test:services": "bash scripts/test-services.sh"
  }
}
