{
  "name": "pff-pk-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.portable.config.ts",
    "dev:full": "bash scripts/run_dashboard.sh",
    "dev:portable:full": "bash scripts/run_portable_dashboard.sh",
    "build": "vite build --config vite.portable.config.ts",
    "build:portable": "vite build --config vite.portable.config.ts",
    "preview:portable": "vite preview --config vite.portable.config.ts",
    "inference": "bash scripts/run_inference_service.sh",
    "test": "npm run build && node --test tests/*.test.mjs && vitest run tests/*.vitest.test.ts tests/*.vitest.test.tsx",
    "lint": "eslint . --ignore-pattern portable-dist",
    "data:build": "bash scripts/build_data.sh"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@gradio/client": "^2.5.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13",
    "vitest": "^5.0.0"
  },
  "type": "module"
}
